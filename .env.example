# Environment Configuration for IntelliAttend

# Server Configuration
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=*

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (Defaults to SQLite; supports PostgreSQL on Railway)
DATABASE_URL=sqlite:///./attendance_system.db

# Storage / AI Paths (Optional overrides)
AI_MODEL_DIR=/app/ai-model
DATASET_DIR=/app/ai-model/dataset
MODEL_PATH=/app/ai-model/trainer.yml
